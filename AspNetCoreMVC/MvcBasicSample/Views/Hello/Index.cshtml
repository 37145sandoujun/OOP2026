@*このViewがProduct型を受け取る宣言*@
@model List<MvcBasicSample.Models.Product>

@{
    ViewData["Title"] = "商品情報";//タブ用のタイトル
    string name = "</b>";

    int a = 0;
}

<h1>商品情報</h1>@*画面内の見出し*@
@*件数が０なら説明だけ表示する*@
@if(Model.Count == 0)
{
    <p>商品はありません</p>
}
else
{
    <p>@Model.Count 件の商品があります</p>
}
<ul>
    @foreach (var product in Model)
    {
        <li>@product.Name @product.Price</li>
        a += product.Price;

    }


</ul>
<p>合計金額　@a　円</p>

